# Company-specific scripts and data: they stay on this PC
local/

# Neural networks: fetched or built by scripts/ (get_ocr_models.py,
# make_backbone.py, make_part_model.py) -- too large for git
models/ocr/
models/backbone/
models/parts/

# A crop of a production photograph; the tests that use it skip without it
tests/testdata/real_led_band.png

# Local pip wheels and generated output
wheels/
gallery/

# Application build output (build_app.bat)
build/
dist/

# the GPU training environment (PyTorch + Ultralytics), made by scripts/train_parts.py's instructions
.venv-train/

# YOLO base weights for training (scripts/train_parts.py downloads them)
models/base/
